# Which forecaster to use: chronos | timemoe | fake
FORECASTER=chronos
CHRONOS_MODEL=amazon/chronos-bolt-small
# Forecast horizon in bars (16 x M15 = 4 hours)
HORIZON=16
CONTEXT_LEN=200
# grading = informational only; veto = AI may block (enable only after calibration)
MODE=grading
CONFIRM_THRESHOLD=0.6
# Create a bot with @BotFather, get chat id from /getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DB_PATH=xau_assistant.db
