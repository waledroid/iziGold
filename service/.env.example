# Which forecaster to use: rules | chronos | timemoe | fake
# rules = deterministic neutral fast tier (use with the DeepSeek agent below)
FORECASTER=rules
CHRONOS_MODEL=amazon/chronos-bolt-small
# Forecast horizon in bars of the chart timeframe (16 x M5 = 80 min; 16 x M15 = 4 h)
HORIZON=16
CONTEXT_LEN=200
# grading = informational only; veto = AI may block (enable only after calibration)
MODE=grading
CONFIRM_THRESHOLD=0.6
# Create a bot with @BotFather, get chat id from /getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DB_PATH=xau_assistant.db
# Mini-app feed service — shared secret the Windows bridge sends
# as X-Feed-Key on every /feed/push; scripts/setup.sh generates one if blank.
FEED_KEY=
# Mini-app HTTP port — the SINGLE source of truth for the live-chart
# service, the Windows bridge push target, the ngrok forward target and
# the watchdog/status probes. Default moved 9001 -> 9101 (2026-08-19):
# 9001 is a popular default (a Docker mosquitto WebSocket listener owns it
# on this machine) and the collision cost the chart, the tunnel AND the
# watchdog. Change it here if 9101 is taken too; setup.sh reads it.
MINIAPP_PORT=9101
# Live heartbeat interval in seconds the service pushes to the EA. The service
# is authoritative (MT5 keeps a chart EA's saved inputs across recompiles).
HEARTBEAT_SEC=1
# true = skip viewer auth on /api/history and /ws (local dev only). Phase 3
# replaces this with real Telegram-initData auth; never set true when the
# mini-app is reachable from outside 127.0.0.1.
MINIAPP_DEV_BYPASS=false
# ngrok static-domain tunnel (Phase 3 Task 2) — publishes the mini-app
# (MINIAPP_PORT only) publicly. Both required together; leave either blank
# and scripts/setup.sh's tunnel phase SKIPs cleanly. Get a free static
# domain + authtoken at https://dashboard.ngrok.com.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
MINIAPP_PUBLIC_URL=
# BotFather /newapp direct link (t.me/<bot>/<shortname>) — used for channel copies
MINIAPP_DIRECT_LINK=

# --- DeepSeek supervisory agent (optional, modular, fail-open) -------------
# Disabled by default: with AGENT_ENABLED=false the system behaves exactly as
# it did before the agent existed. When enabled but unreachable, grading is
# "pending" and the strategy keeps trading untouched.
AGENT_ENABLED=false
# L0 observer | L1 governor (pause/resume only) | L3 supervisory (+close/move)
AGENT_LEVEL=L3
AGENT_MODEL=deepseek-v4.1-flash
AGENT_PROVIDER=opencode-go
# OpenAI-compatible base URL, e.g. https://<host>/v1  (no trailing /chat/...)
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_TIMEOUT_S=30
AGENT_CONTEXT_BARS=120
AGENT_SUPERVISOR_INTERVAL_S=300
# Hard bounds for autonomous actions
AGENT_MAX_ACTIONS_PER_HOUR=4
AGENT_MAX_ACTIONS_PER_DAY=10
# Demo-only actions unless explicitly enabled (live money safety rail)
AGENT_ALLOW_LIVE_ACTIONS=false
# Lane / entry-mode switching stays off unless explicitly enabled
AGENT_ALLOW_LANE_SWITCH=false
# Calibration gate: LIVE actions need this much resolved evidence, unless bypassed
AGENT_MIN_RESOLVED=50
AGENT_MIN_ACCURACY_PCT=55
AGENT_GATE_BYPASS=false
AGENT_LESSONS_MAX=5
AGENT_PROMPT_VERSION=xau-agent-v2
